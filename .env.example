# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional secret key for real Stripe Checkout / PaymentIntent API calls.
STRIPE_SECRET_KEY=""

# MERCADOPAGO_ACCESS_TOKEN: Optional access token for real Mercado Pago PIX & Checkout Pro API calls.
MERCADOPAGO_ACCESS_TOKEN=""
